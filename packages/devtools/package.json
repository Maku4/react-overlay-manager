{
  "name": "@react-overlay-manager/devtools",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "description": "Developer tools for React Overlay Manager - visual debugging and management interface",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "!dist/**/*.test-d.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --root ../.. packages/devtools/",
    "test:coverage": "vitest run --root ../.. packages/devtools/ --coverage",
    "test:types": "tsd"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@react-overlay-manager/core": "workspace:^"
  },
  "devDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsd": "^0.33.0"
  },
  "keywords": [
    "react",
    "overlay",
    "devtools",
    "debugging",
    "development",
    "typescript"
  ],
  "author": "Mateusz Kuplowski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maku4/react-overlay-manager.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://github.com/Maku4/react-overlay-manager#readme",
  "bugs": {
    "url": "https://github.com/Maku4/react-overlay-manager/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsd": {
    "directory": "types-tests"
  }
}
